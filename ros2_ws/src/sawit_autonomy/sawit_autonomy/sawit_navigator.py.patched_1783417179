class State(Enum):
    WAIT_DATA = 0
    PRESTREAM = 1
    TAKEOFF = 2
    SEARCH = 3
    APPROACH = 4
    HOLD_SCAN = 5
    BACKUP = 6
    FINISHED = 7


@dataclass
class TreeTrack:
    tree_id: int
    x: float
    y: float
    z: float
    confirmations: int
    confirmed: bool
    visited: bool
    last_seen: float


