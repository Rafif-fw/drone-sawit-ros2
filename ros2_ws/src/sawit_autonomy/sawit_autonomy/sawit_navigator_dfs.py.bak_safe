#!/usr/bin/env python3
"""
sawit_navigator_dfs.py

TRUE GRID DFS:
- Sama seperti BFS, tapi urutan grid memakai DFS/stack per kolom.
- PointCloud tetap sumber deteksi.
- Grid hanya untuk urutan scan dan gate supaya tidak pohon ghaib.
"""

import math
import time
import numpy as np
import rclpy
from rclpy.executors import MultiThreadedExecutor

from sawit_autonomy.sawit_navigator_fast import SawitRandomPointCloudNavigator


class SawitNavigatorDFS(SawitRandomPointCloudNavigator):
    def __init__(self):
        super().__init__()

        self.visit_distance = 3.0
        self.tof_visit_distance = 2.0
        self.tof_visit_max_distance = 5.5
        self.tof_stop_distance = 2.65
        self.cloud_stop_distance = 2.35
        self.cloud_stop_width = 0.75

        self.approach_standoff = 4.6
        self.max_step = 0.20
        self.max_yaw_step = math.radians(5.0)

        self.use_actual_seed_fallback = False
        self.snap_track_to_actual = False
        self.actual_gate_enabled = False

        self.max_forward = 22.0
        self.max_abs_left = 10.5
        self.min_confirmations = 3
        self.stable_confirmations = 3
        self.target_recent_age = 15.0
        self.active_target_stale_timeout = 90.0
        self.approach_stall_timeout = 18.0

        xs = [-12.0, -4.0, 4.0, 12.0]
        ys = [12.0, 20.0, 28.0, 36.0]

        # DFS = satu kolom dulu sampai belakang, lalu kolom berikutnya.
        self.grid_centers = []
        for c, x in enumerate(xs):
            col = ys if c % 2 == 0 else list(reversed(ys))
            for y in col:
                self.grid_centers.append((x, y))

        self.grid_scan_offset = 4.2
        self.search_waypoints_rel = [
            (x, y - self.grid_scan_offset) for x, y in self.grid_centers
        ]

        self.search_wp_index = 0
        self.grid_gate_radius = 4.5
        self.grid_visit_radius = 4.4
        self.explore_tolerance = 2.0
        self.explore_timeout = 60.0

        self.get_logger().warn(
            "TRUE GRID DFS aktif: urutan DFS grid 4x4, "
            "select_target dibatasi cell gate, bukan random cloud global"
        )


    def nearest_grid_info(self, x, y):
        best = None
        for i, (gx, gy) in enumerate(self.grid_centers):
            d = math.hypot(float(x) - gx, float(y) - gy)
            if best is None or d < best[0]:
                best = (d, i, gx, gy)
        if best is None:
            return None
        d, i, gx, gy = best
        return i, gx, gy, d

    def apply_grid_mapping_to_obs(self, obs):
        """
        NATURAL POINTCLOUD + GRID MAPPING.
        Bukan actual/SDF. Cloud hasil kamera hanya diterima kalau dekat
        node grid sawit 4x4 spacing 8 m. Setelah valid, posisi track
        dikunci ke center grid supaya 1 pohon = 1 marker dan tidak gerak-gerak.
        """
        self._grid_forced_id = None

        x = float(obs[0])
        y = float(obs[1])
        z = float(obs[2]) if len(obs) > 2 else 0.0

        info = self.nearest_grid_info(x, y)
        if info is None:
            return None

        gid, gx, gy, err = info

        # radius harus < 4m karena jarak antar pohon 8m.
        # Ini buang cloud daun/ghost di tengah antar pohon.
        if err > self.grid_gate_radius:
            return None

        self._grid_forced_id = int(gid)

        try:
            obs[0] = float(gx)
            obs[1] = float(gy)
            obs[2] = float(z)
            return obs
        except Exception:
            return np.array([float(gx), float(gy), float(z)], dtype=float)

    def current_grid_center(self):
        if not self.grid_centers:
            return None
        i = max(0, min(int(self.search_wp_index), len(self.grid_centers) - 1))
        return self.grid_centers[i]

    def track_near_grid(self, track, center=None):
        if center is None:
            center = self.current_grid_center()
        if center is None:
            return False
        gx, gy = center
        return math.hypot(float(track.x) - gx, float(track.y) - gy) <= self.grid_gate_radius

    def current_grid_has_visited(self):
        c = self.current_grid_center()
        if c is None:
            return False
        for t in self.confirmed_tracks():
            if t.visited and self.track_near_grid(t, c):
                return True
        return False

    def skip_visited_grid_cells(self):
        while self.search_wp_index < len(self.grid_centers) and self.current_grid_has_visited():
            old = self.search_wp_index
            self.search_wp_index += 1
            self.explore_waypoint = None
            self.get_logger().info(f"GRID_DFS_SKIP_VISITED_CELL {old}->{self.search_wp_index}")

        if self.search_wp_index >= len(self.grid_centers):
            self.search_wp_index = len(self.grid_centers) - 1

    def select_target(self) -> bool:
        if not self.position_valid:
            return False

        self.skip_visited_grid_cells()
        center = self.current_grid_center()
        if center is None:
            return False

        now = time.monotonic()
        gx, gy = center
        candidates = []

        for track in self.confirmed_tracks():
            if track.visited:
                continue
            if self.blocked_target_id == track.tree_id and now < self.blocked_target_until:
                continue
            if not self.track_near_grid(track, center):
                continue

            grid_err = math.hypot(float(track.x) - gx, float(track.y) - gy)
            drone_dist = math.hypot(float(track.x) - self.position[0], float(track.y) - self.position[1])
            candidates.append((grid_err, drone_dist, track))

        if not candidates:
            if now - getattr(self, "_last_grid_wait_log", 0.0) > 2.0:
                self._last_grid_wait_log = now
                self.get_logger().info(
                    f"GRID_DFS_SCAN_CELL idx={self.search_wp_index} "
                    f"center=({gx:.1f},{gy:.1f}) waiting_cloud"
                )
            return False

        candidates.sort(key=lambda item: (item[0], item[1]))
        err, dist, track = candidates[0]
        self.active_target_id = track.tree_id
        self.get_logger().info(
            f"GRID_DFS_TARGET idx={self.search_wp_index} id={track.tree_id} "
            f"grid_err={err:.2f} dist={dist:.2f} cloud=({track.x:.2f},{track.y:.2f})"
        )
        return True

    def mark_nearby_confirmed_tracks(self):
        if not self.position_valid:
            return

        for track in self.confirmed_tracks():
            if track.visited:
                continue

            in_any_grid = any(
                math.hypot(float(track.x) - gx, float(track.y) - gy) <= self.grid_gate_radius
                for gx, gy in self.grid_centers
            )
            if not in_any_grid:
                continue

            d = math.hypot(float(track.x) - self.position[0], float(track.y) - self.position[1])
            if d <= self.visit_distance:
                track.visited = True
                self.get_logger().info(
                    f"TREE_VISITED_GRID_DFS id={track.tree_id} dist={d:.2f}: "
                    f"{self.count_visited()}/{self.max_visited}"
                )
                self.skip_visited_grid_cells()

    def advance_waypoint(self, reason: str):
        old_idx = int(self.search_wp_index)
        self.search_wp_index = min(old_idx + 1, len(self.search_waypoints_rel) - 1)
        self.explore_waypoint = None
        self.explore_started = 0.0
        self.get_logger().info(
            f"GRID_DFS_WAYPOINT_ADVANCE reason={reason} {old_idx}->{self.search_wp_index}"
        )



# ===== GRID UNIQUE PATCH V2 START =====
def _grid_v2_raw_tracks(self):
    try:
        return list(SawitRandomPointCloudNavigator.confirmed_tracks(self))
    except Exception:
        return []

def _grid_v2_nearest_grid_info(self, x, y):
    centers = getattr(self, "grid_centers", [])
    if not centers:
        return None
    best = None
    for i, (gx, gy) in enumerate(centers):
        d = math.hypot(float(x) - float(gx), float(y) - float(gy))
        if best is None or d < best[3]:
            best = (i, float(gx), float(gy), float(d))
    return best

def _grid_v2_visited_grid_ids(self):
    gate = float(getattr(self, "grid_gate_radius", 3.0)) + 0.8
    ids = set()
    for t in _grid_v2_raw_tracks(self):
        if not getattr(t, "visited", False):
            continue
        info = _grid_v2_nearest_grid_info(self, t.x, t.y)
        if info is None:
            continue
        gid, gx, gy, err = info
        if err <= gate:
            ids.add(gid)
    return ids

def _grid_v2_mark_grid_visited(self, gid):
    gate = float(getattr(self, "grid_gate_radius", 3.0)) + 0.8
    now = time.monotonic()
    for t in _grid_v2_raw_tracks(self):
        info = _grid_v2_nearest_grid_info(self, t.x, t.y)
        if info is None:
            continue
        tid, gx, gy, err = info
        if tid == gid and err <= gate:
            t.visited = True
            t.x = gx
            t.y = gy
            t.last_seen = now

def _grid_v2_confirmed_tracks(self):
    """
    Tampilkan/pakai hanya 1 track per cell grid.
    Jadi tidak ada lagi 1 pohon punya marker hijau + kuning.
    """
    raw = _grid_v2_raw_tracks(self)
    if not raw:
        return []

    gate = float(getattr(self, "grid_gate_radius", 3.0)) + 0.8
    groups = {}
    visited_ids = _grid_v2_visited_grid_ids(self)

    for t in raw:
        info = _grid_v2_nearest_grid_info(self, t.x, t.y)
        if info is None:
            continue
        gid, gx, gy, err = info
        if err > gate:
            continue
        groups.setdefault(gid, []).append((err, t, gx, gy))

    unique = []
    for gid in sorted(groups.keys()):
        items = groups[gid]

        # pilih visited dulu kalau ada, supaya duplicate kuning kalah oleh hijau
        items.sort(key=lambda item: (not getattr(item[1], "visited", False), item[0]))
        err, chosen, gx, gy = items[0]

        if gid in visited_ids:
            for _, tt, _, _ in items:
                tt.visited = True
            chosen.visited = True

        chosen.x = gx
        chosen.y = gy
        unique.append(chosen)

    return unique

def _grid_v2_count_visited(self):
    return len(_grid_v2_visited_grid_ids(self))

def _grid_v2_next_unvisited_index(self, start=0):
    centers = getattr(self, "grid_centers", [])
    if not centers:
        return None

    visited = _grid_v2_visited_grid_ids(self)
    n = len(centers)

    if len(visited) >= n:
        return None

    start = int(start) % n
    for k in range(n):
        i = (start + k) % n
        if i not in visited:
            return i
    return None

def _grid_v2_current_grid_center(self):
    centers = getattr(self, "grid_centers", [])
    if not centers:
        return None

    if int(getattr(self, "search_wp_index", 0)) >= len(centers):
        nxt = _grid_v2_next_unvisited_index(self, 0)
        if nxt is not None:
            self.search_wp_index = nxt
        else:
            self.search_wp_index = len(centers) - 1

    i = max(0, min(int(self.search_wp_index), len(centers) - 1))
    return centers[i]

def _grid_v2_current_grid_has_visited(self):
    centers = getattr(self, "grid_centers", [])
    if not centers:
        return False
    i = max(0, min(int(getattr(self, "search_wp_index", 0)), len(centers) - 1))
    return i in _grid_v2_visited_grid_ids(self)

def _grid_v2_skip_visited_grid_cells(self):
    centers = getattr(self, "grid_centers", [])
    if not centers:
        return

    visited = _grid_v2_visited_grid_ids(self)
    if len(visited) >= len(centers):
        return

    cur = int(getattr(self, "search_wp_index", 0))
    if cur >= len(centers) or cur in visited:
        nxt = _grid_v2_next_unvisited_index(self, cur + 1)
        if nxt is not None:
            old = cur
            self.search_wp_index = nxt
            self.explore_waypoint = None
            self.get_logger().info(f"GRID_SKIP_TO_UNVISITED {old}->{nxt}")

def _grid_v2_apply_grid_mapping_to_obs(self, obs):
    """
    PointCloud tetap natural.
    Tapi hasil deteksi dikunci ke node grid 4x4 agar:
    - 1 pohon = 1 node
    - marker tidak geser-geser
    - duplicate cloud di pohon yang sama tidak jadi pohon baru
    """
    self._grid_forced_id = None

    x = float(obs[0])
    y = float(obs[1])
    z = float(obs[2]) if len(obs) > 2 else 0.0

    info = _grid_v2_nearest_grid_info(self, x, y)
    if info is None:
        return None

    gid, gx, gy, err = info
    gate = float(getattr(self, "grid_gate_radius", 3.0))

    if err > gate:
        return None

    # kalau cell ini sudah punya track, pakai ID track lama, jangan bikin ID baru
    old_id = None
    for t in _grid_v2_raw_tracks(self):
        info2 = _grid_v2_nearest_grid_info(self, t.x, t.y)
        if info2 is None:
            continue
        gid2, _, _, err2 = info2
        if gid2 == gid and err2 <= gate + 0.8:
            old_id = t.tree_id
            break

    self._grid_forced_id = old_id if old_id is not None else int(gid)

    try:
        obs[0] = gx
        obs[1] = gy
        obs[2] = z
        return obs
    except Exception:
        return np.array([gx, gy, z], dtype=float)

def _grid_v2_select_target(self):
    if not self.position_valid:
        return False

    _grid_v2_skip_visited_grid_cells(self)

    center = _grid_v2_current_grid_center(self)
    if center is None:
        return False

    now = time.monotonic()
    gx, gy = center
    cur_info = _grid_v2_nearest_grid_info(self, gx, gy)
    cur_gid = cur_info[0] if cur_info else int(getattr(self, "search_wp_index", 0))

    candidates = []
    for track in _grid_v2_confirmed_tracks(self):
        info = _grid_v2_nearest_grid_info(self, track.x, track.y)
        if info is None:
            continue
        gid, cgx, cgy, err = info

        if gid != cur_gid:
            continue

        if track.visited:
            _grid_v2_mark_grid_visited(self, gid)
            continue

        if self.blocked_target_id == track.tree_id and now < self.blocked_target_until:
            continue

        drone_dist = math.hypot(float(track.x) - self.position[0], float(track.y) - self.position[1])
        candidates.append((err, drone_dist, track))

    if not candidates:
        if now - getattr(self, "_last_grid_wait_log", 0.0) > 2.0:
            self._last_grid_wait_log = now
            self.get_logger().info(
                f"GRID_SCAN_CELL idx={self.search_wp_index} center=({gx:.1f},{gy:.1f}) waiting_cloud"
            )
        return False

    candidates.sort(key=lambda item: (item[0], item[1]))
    err, dist, track = candidates[0]
    self.active_target_id = track.tree_id
    self.get_logger().info(
        f"GRID_TARGET idx={self.search_wp_index} id={track.tree_id} "
        f"grid_err={err:.2f} dist={dist:.2f} cloud=({track.x:.2f},{track.y:.2f})"
    )
    return True

def _grid_v2_mark_nearby_confirmed_tracks(self):
    if not self.position_valid:
        return

    for track in _grid_v2_confirmed_tracks(self):
        info = _grid_v2_nearest_grid_info(self, track.x, track.y)
        if info is None:
            continue

        gid, gx, gy, err = info
        if track.visited:
            continue

        d_grid = math.hypot(float(gx) - self.position[0], float(gy) - self.position[1])
        d_track = math.hypot(float(track.x) - self.position[0], float(track.y) - self.position[1])
        d = min(d_grid, d_track)

        if d <= self.visit_distance:
            _grid_v2_mark_grid_visited(self, gid)
            self.get_logger().info(
                f"TREE_VISITED_GRID id={gid} dist={d:.2f}: "
                f"{_grid_v2_count_visited(self)}/{self.max_visited}"
            )
            _grid_v2_skip_visited_grid_cells(self)

def _grid_v2_advance_waypoint(self, reason):
    old = int(getattr(self, "search_wp_index", 0))
    nxt = _grid_v2_next_unvisited_index(self, old + 1)

    if nxt is None:
        self.search_wp_index = len(getattr(self, "grid_centers", [])) - 1
    else:
        self.search_wp_index = nxt

    self.explore_waypoint = None
    self.explore_started = 0.0
    self.get_logger().info(
        f"GRID_WAYPOINT_ADVANCE reason={reason} {old}->{self.search_wp_index}"
    )

SawitNavigatorDFS.confirmed_tracks = _grid_v2_confirmed_tracks
SawitNavigatorDFS.count_visited = _grid_v2_count_visited
SawitNavigatorDFS.current_grid_center = _grid_v2_current_grid_center
SawitNavigatorDFS.current_grid_has_visited = _grid_v2_current_grid_has_visited
SawitNavigatorDFS.skip_visited_grid_cells = _grid_v2_skip_visited_grid_cells
SawitNavigatorDFS.apply_grid_mapping_to_obs = _grid_v2_apply_grid_mapping_to_obs
SawitNavigatorDFS.select_target = _grid_v2_select_target
SawitNavigatorDFS.mark_nearby_confirmed_tracks = _grid_v2_mark_nearby_confirmed_tracks
SawitNavigatorDFS.advance_waypoint = _grid_v2_advance_waypoint
# ===== GRID UNIQUE PATCH V2 END =====



# ===== GRID HOLD PATCH V3 START =====
def _grid_v3_advance_waypoint(self, reason):
    old = int(getattr(self, "search_wp_index", 0))

    # Jangan skip cell karena timeout kalau drone belum sampai waypoint scan.
    # Ini yang bikin cell samping belum discan tapi sudah pindah ke tengah.
    if reason == "coverage_timeout":
        wp = getattr(self, "explore_waypoint", None)
        pos = getattr(self, "position", None)

        if wp is not None and pos is not None:
            d = math.hypot(float(wp[0]) - float(pos[0]), float(wp[1]) - float(pos[1]))

            # Kalau masih jauh, tahan di cell ini.
            if d > 3.0:
                self.explore_started = time.monotonic()
                self.get_logger().info(
                    f"GRID_HOLD_CURRENT_CELL timeout_but_not_reached "
                    f"idx={old} dist_to_scan_wp={d:.2f}"
                )
                return

    # Kalau sudah dekat atau reason lain, baru boleh advance.
    return _grid_v2_advance_waypoint(self, reason)

SawitNavigatorDFS.advance_waypoint = _grid_v3_advance_waypoint
# ===== GRID HOLD PATCH V3 END =====



# ===== GRID SAFE PATCH V4 START =====
import math as _grid_v4_math
import time as _grid_v4_time

def _grid_v4_track_xy(t):
    return float(getattr(t, "x", 0.0)), float(getattr(t, "y", 0.0))

def _grid_v4_track_id(t):
    return getattr(t, "tree_id", getattr(t, "cloud_id", -1))

def _grid_v4_cell_visited(self, idx):
    if not getattr(self, "grid_centers", None):
        return False
    gx, gy = self.grid_centers[idx]
    gate = float(getattr(self, "grid_gate_radius", 4.5))
    for t in self.confirmed_tracks():
        if not getattr(t, "visited", False):
            continue
        tx, ty = _grid_v4_track_xy(t)
        if _grid_v4_math.hypot(tx - gx, ty - gy) <= gate:
            return True
    return False

def _grid_v4_skip_visited_grid_cells(self):
    if not getattr(self, "grid_centers", None):
        return

    n = len(self.grid_centers)
    if n <= 0:
        return

    self.search_wp_index = max(0, min(int(getattr(self, "search_wp_index", 0)), n - 1))

    # Cari cell berikutnya yang belum visited. Kalau sampai akhir, muter lagi
    # supaya cell pojok yang kelewat tetap dicoba ulang.
    start = self.search_wp_index
    for step in range(n):
        idx = (start + step) % n
        if not _grid_v4_cell_visited(self, idx):
            if idx != self.search_wp_index:
                old = self.search_wp_index
                self.search_wp_index = idx
                self.explore_waypoint = None
                self.get_logger().info(f"GRID_SECOND_PASS_TO_UNVISITED {old}->{idx}")
            return

def _grid_v4_track_near_grid(self, track, center=None):
    if center is None:
        center = self.current_grid_center()
    if center is None:
        return False
    tx, ty = _grid_v4_track_xy(track)
    gx, gy = center
    return _grid_v4_math.hypot(tx - gx, ty - gy) <= float(getattr(self, "grid_gate_radius", 4.5))

def _grid_v4_mark_nearby_confirmed_tracks(self):
    if not getattr(self, "position_valid", False):
        return

    px, py = float(self.position[0]), float(self.position[1])
    visit_r = float(getattr(self, "grid_visit_radius", 4.4))
    gate = float(getattr(self, "grid_gate_radius", 4.5))

    for track in self.confirmed_tracks():
        if getattr(track, "visited", False):
            continue

        tx, ty = _grid_v4_track_xy(track)

        # Track harus masih masuk area grid sawit, supaya ghost tidak dihitung.
        in_grid = False
        for gx, gy in getattr(self, "grid_centers", []):
            if _grid_v4_math.hypot(tx - gx, ty - gy) <= gate:
                in_grid = True
                break
        if not in_grid:
            continue

        d = _grid_v4_math.hypot(tx - px, ty - py)
        if d <= visit_r:
            track.visited = True
            self.get_logger().info(
                f"TREE_VISITED_GRID_SAFE id={_grid_v4_track_id(track)} dist={d:.2f}: "
                f"{self.count_visited()}/{self.max_visited}"
            )

    _grid_v4_skip_visited_grid_cells(self)

def _grid_v4_select_target(self):
    if not getattr(self, "position_valid", False):
        return False

    now = _grid_v4_time.monotonic()

    # Kalau ToF sudah dekat, jangan maksa pilih target jauh di balik pohon.
    tof = float(getattr(self, "tof_front_min", 99.0))
    if tof < 2.15:
        self.mark_nearby_confirmed_tracks()
        self.active_target_id = None
        if now - getattr(self, "_grid_v4_tof_log", 0.0) > 1.2:
            self._grid_v4_tof_log = now
            self.get_logger().warn(f"GRID_SAFE_TOF_HOLD tof={tof:.2f}; avoid selecting far target")
        return False

    _grid_v4_skip_visited_grid_cells(self)
    center = self.current_grid_center()
    if center is None:
        return False

    gx, gy = center
    candidates = []

    for track in self.confirmed_tracks():
        if getattr(track, "visited", False):
            continue

        tid = _grid_v4_track_id(track)
        if getattr(self, "blocked_target_id", None) == tid and now < getattr(self, "blocked_target_until", 0.0):
            continue

        tx, ty = _grid_v4_track_xy(track)

        grid_err = _grid_v4_math.hypot(tx - gx, ty - gy)
        if grid_err > float(getattr(self, "grid_gate_radius", 4.5)):
            continue

        drone_dist = _grid_v4_math.hypot(tx - float(self.position[0]), ty - float(self.position[1]))

        # Proteksi nabrak: kalau target masih jauh tapi sensor depan sudah dekat,
        # jangan pilih target itu dulu.
        if tof < 2.7 and drone_dist > 5.5:
            continue

        candidates.append((grid_err, drone_dist, track))

    if not candidates:
        if now - getattr(self, "_last_grid_wait_log", 0.0) > 2.0:
            self._last_grid_wait_log = now
            self.get_logger().info(
                f"GRID_SCAN_CELL idx={self.search_wp_index} "
                f"center=({gx:.1f},{gy:.1f}) waiting_cloud"
            )
        return False

    candidates.sort(key=lambda item: (item[0], item[1]))
    err, dist, track = candidates[0]
    self.active_target_id = _grid_v4_track_id(track)
    self.get_logger().info(
        f"GRID_TARGET_SAFE idx={self.search_wp_index} id={self.active_target_id} "
        f"grid_err={err:.2f} dist={dist:.2f} cloud=({_grid_v4_track_xy(track)[0]:.2f},{_grid_v4_track_xy(track)[1]:.2f})"
    )
    return True

def _grid_v4_advance_waypoint(self, reason):
    old = int(getattr(self, "search_wp_index", 0))
    n = len(getattr(self, "search_waypoints_rel", []))
    if n <= 0:
        return

    # Kalau timeout tapi belum sampai scan point, jangan loncat.
    if reason == "coverage_timeout":
        wp = getattr(self, "explore_waypoint", None)
        if wp is not None and getattr(self, "position_valid", False):
            d = _grid_v4_math.hypot(float(wp[0]) - float(self.position[0]), float(wp[1]) - float(self.position[1]))
            if d > 2.5:
                self.explore_started = _grid_v4_time.monotonic()
                self.get_logger().info(f"GRID_HOLD_CELL idx={old} dist_to_wp={d:.2f}")
                return

    self.search_wp_index = (old + 1) % n
    self.explore_waypoint = None
    self.explore_started = 0.0
    _grid_v4_skip_visited_grid_cells(self)

    self.get_logger().info(
        f"GRID_WAYPOINT_ADVANCE_SAFE reason={reason} {old}->{self.search_wp_index}"
    )

SawitNavigatorDFS.track_near_grid = _grid_v4_track_near_grid
SawitNavigatorDFS.skip_visited_grid_cells = _grid_v4_skip_visited_grid_cells
SawitNavigatorDFS.mark_nearby_confirmed_tracks = _grid_v4_mark_nearby_confirmed_tracks
SawitNavigatorDFS.select_target = _grid_v4_select_target
SawitNavigatorDFS.advance_waypoint = _grid_v4_advance_waypoint
# ===== GRID SAFE PATCH V4 END =====



# ===== GRID SAFE LANE V5 START =====
import math as _grid_v5_math
import time as _grid_v5_time

def _grid_v5_lane_point(self, center):
    cx, cy = float(center[0]), float(center[1])

    # Jarak antar pohon 8 m, jadi jalur aman dibuat 4.2 m dari kolom pohon.
    # Kolom kiri masuk lane kiri, kolom kanan masuk lane kanan.
    xs = sorted({round(float(x), 2) for x, y in getattr(self, "grid_centers", [])})

    if xs:
        idx = min(range(len(xs)), key=lambda i: abs(xs[i] - cx))
        if idx <= 1:
            sx = cx - 4.2
        else:
            sx = cx + 4.2
    else:
        sx = cx - 4.2 if cx < 0.0 else cx + 4.2

    # scan dari sela bawah baris pohon, bukan tepat di batang
    sy = cy - 4.2
    return (sx, sy)

def _grid_v5_rebuild_lanes(self):
    centers = list(getattr(self, "grid_centers", []))
    if not centers:
        return

    self.grid_scan_offset = 4.2
    self.grid_gate_radius = 4.5
    self.grid_visit_radius = 4.6

    # lebih aman dulu, jangan terlalu cepat karena tadi nabrak awal
    self.max_step = 0.20
    self.visit_distance = 3.0
    self.approach_standoff = 4.6
    self.tof_stop_distance = 2.65
    self.tof_visit_distance = 2.0
    self.tof_visit_max_distance = 5.5
    self.cloud_stop_distance = 2.35

    safe_wps = [_grid_v5_lane_point(self, c) for c in centers]

    # pakai nama apa pun yang dipakai file BFS/DFS
    self.search_waypoints_rel = safe_wps
    if hasattr(self, "search_waypoints"):
        self.search_waypoints = safe_wps
    if hasattr(self, "coverage_waypoints"):
        self.coverage_waypoints = safe_wps

    self.get_logger().warn(
        "GRID SAFE LANE V5 aktif: waypoint scan digeser ke sela antar pohon, bukan garis batang"
    )

def _grid_v5_center_now(self):
    centers = list(getattr(self, "grid_centers", []))
    if not centers:
        return None
    idx = int(getattr(self, "search_wp_index", 0)) % len(centers)
    return centers[idx]

def _grid_v5_wp_unsafe(self, wp, center):
    if wp is None or center is None:
        return True
    wx, wy = float(wp[0]), float(wp[1])
    cx, cy = float(center[0]), float(center[1])

    # unsafe kalau masih sejajar kolom batang dan dekat baris pohon
    same_column = abs(wx - cx) < 1.5
    near_tree_row = abs(wy - cy) < 6.0
    return same_column and near_tree_row

def _grid_v5_force_lane_waypoint(self):
    centers = list(getattr(self, "grid_centers", []))
    if not centers:
        return None

    idx = int(getattr(self, "search_wp_index", 0)) % len(centers)
    center = centers[idx]

    if not getattr(self, "search_waypoints_rel", None):
        _grid_v5_rebuild_lanes(self)

    wp = getattr(self, "explore_waypoint", None)

    if _grid_v5_wp_unsafe(self, wp, center):
        wp = _grid_v5_lane_point(self, center)
        self.explore_waypoint = wp
        self.explore_started = _grid_v5_time.monotonic()
        self.get_logger().warn(
            f"GRID_LANE_WAYPOINT idx={idx} center=({center[0]:.1f},{center[1]:.1f}) "
            f"safe_wp=({wp[0]:.2f},{wp[1]:.2f})"
        )

    return self.explore_waypoint

def _grid_v5_get_explore_waypoint(self, *args, **kwargs):
    return _grid_v5_force_lane_waypoint(self)

def _grid_v5_wrap_coverage(orig):
    def wrapper(self, *args, **kwargs):
        _grid_v5_force_lane_waypoint(self)
        return orig(self, *args, **kwargs)
    return wrapper

_ORIG_INIT_GRID_V5 = SawitNavigatorDFS.__init__

def _grid_v5_init(self, *args, **kwargs):
    _ORIG_INIT_GRID_V5(self, *args, **kwargs)
    _grid_v5_rebuild_lanes(self)

SawitNavigatorDFS.__init__ = _grid_v5_init

# Override / wrap kemungkinan nama fungsi yang dipakai file
for _name in [
    "get_explore_waypoint",
    "make_explore_waypoint",
    "ensure_explore_waypoint",
    "create_explore_waypoint",
]:
    if hasattr(SawitNavigatorDFS, _name):
        setattr(SawitNavigatorDFS, _name, _grid_v5_get_explore_waypoint)

for _name in [
    "natural_coverage_move",
    "coverage_move",
    "do_coverage_move",
    "explore_move",
    "run_explore_move",
]:
    if hasattr(SawitNavigatorDFS, _name):
        setattr(SawitNavigatorDFS, _name, _grid_v5_wrap_coverage(getattr(SawitNavigatorDFS, _name)))
# ===== GRID SAFE LANE V5 END =====



# ===== GRID YAW SCAN V6 START =====
import math as _grid_v6_math
import time as _grid_v6_time

def _grid_v6_state_name(self):
    st = getattr(self, "state", "")
    return getattr(st, "name", str(st))

def _grid_v6_pos(self):
    if hasattr(self, "position"):
        return self.position
    if hasattr(self, "local_pos"):
        return self.local_pos
    return None

def _grid_v6_track_xy_by_id(self, tid):
    if tid is None:
        return None
    try:
        tracks = self.confirmed_tracks()
    except Exception:
        tracks = getattr(self, "tracks", [])
    for t in tracks:
        this_id = getattr(t, "tree_id", getattr(t, "cloud_id", None))
        if this_id == tid:
            return float(getattr(t, "x", 0.0)), float(getattr(t, "y", 0.0))
    return None

_ORIG_INIT_GRID_YAW_V6 = SawitNavigatorDFS.__init__

def _grid_v6_init(self, *args, **kwargs):
    _ORIG_INIT_GRID_YAW_V6(self, *args, **kwargs)

    # Cepetan dikit, tapi masih aman biar gak nabrak batang.
    self.max_step = 0.20
    self.visit_distance = 3.0
    self.approach_standoff = 4.6

    # Stop/visit lebih realistis untuk sawit besar.
    self.tof_stop_distance = 2.65
    self.tof_visit_distance = 2.0
    self.tof_visit_max_distance = 6.0
    self.cloud_stop_distance = 2.35
    self.cloud_stop_width = 1.2

    # Jangan gampang stale/mandek pas cloud hilang sebentar.
    self.target_recent_age = 12.0
    self.active_target_stale_timeout = 35.0
    self.approach_stall_timeout = 18.0

    self._grid_v6_last_yaw_log = 0.0
    self.get_logger().warn("GRID YAW SCAN V6 aktif: kamera/yaw diarahkan ke center grid saat scan")

SawitNavigatorDFS.__init__ = _grid_v6_init

_ORIG_PUBLISH_SETPOINT_GRID_YAW_V6 = SawitNavigatorDFS.publish_setpoint

def _grid_v6_publish_setpoint(self, requested, yaw):
    try:
        pos = _grid_v6_pos(self)
        if pos is not None:
            px = float(pos[0])
            py = float(pos[1])
            state_name = _grid_v6_state_name(self)

            # Saat SEARCH/coverage, hadapkan kamera ke center grid yang sedang discan.
            if "SEARCH" in state_name:
                centers = list(getattr(self, "grid_centers", []))
                if centers:
                    idx = int(getattr(self, "search_wp_index", 0)) % len(centers)
                    cx, cy = centers[idx]
                    yaw = _grid_v6_math.atan2(float(cy) - py, float(cx) - px)

                    now = _grid_v6_time.monotonic()
                    if now - getattr(self, "_grid_v6_last_yaw_log", 0.0) > 2.0:
                        self._grid_v6_last_yaw_log = now
                        self.get_logger().info(
                            f"GRID_YAW_SCAN idx={idx} face_center=({float(cx):.1f},{float(cy):.1f})"
                        )

            # Saat APPROACH, hadapkan kamera ke cloud/tree aktif.
            elif "APPROACH" in state_name:
                tid = getattr(self, "active_target_id", None)
                xy = _grid_v6_track_xy_by_id(self, tid)
                if xy is not None:
                    tx, ty = xy
                    yaw = _grid_v6_math.atan2(ty - py, tx - px)

    except Exception as e:
        try:
            self.get_logger().warn(f"GRID_YAW_SCAN_FAIL: {e}")
        except Exception:
            pass

    return _ORIG_PUBLISH_SETPOINT_GRID_YAW_V6(self, requested, yaw)

SawitNavigatorDFS.publish_setpoint = _grid_v6_publish_setpoint
# ===== GRID YAW SCAN V6 END =====



# ===== GRID VISUAL STRICT V7 START =====
import math as _grid_v7_math

def _grid_v7_centers(self):
    centers = list(getattr(self, "grid_centers", []))
    if centers:
        return [(float(x), float(y)) for x, y in centers]

    xs = [-12.0, -4.0, 4.0, 12.0]
    ys = [12.0, 20.0, 28.0, 36.0]
    return [(x, y) for y in ys for x in xs]

_ORIG_INIT_GRID_V7 = SawitNavigatorDFS.__init__

def _grid_v7_init(self, *args, **kwargs):
    _ORIG_INIT_GRID_V7(self, *args, **kwargs)

    # Lebih cepat sedikit, tapi tidak segila random.
    self.max_step = 0.20

    # Jangan visited dari jauh.
    self.visit_distance = 3.0
    self.approach_standoff = 4.6

    # ToF 2.4 m jangan langsung dianggap visited.
    self.tof_stop_distance = 2.65
    self.tof_visit_distance = 2.0
    self.tof_visit_max_distance = 3.70

    # Cloud stop tetap aman tapi tidak terlalu lebay.
    self.cloud_stop_distance = 2.35
    self.cloud_stop_width = 0.90

    # Biar tidak gampang stale waktu scan pojok.
    self.target_recent_age = 14.0
    self.active_target_stale_timeout = 45.0
    self.approach_stall_timeout = 20.0

    try:
        from visualization_msgs.msg import MarkerArray
        self.grid_marker_pub = self.create_publisher(MarkerArray, "/sawit/grid_marker_array", 10)
        self.create_timer(1.0, self._publish_grid_v7_marker)
    except Exception as e:
        self.get_logger().warn(f"GRID_V7 marker pub gagal: {e}")

    self.get_logger().warn(
        "GRID STRICT V7 aktif: 4x4 grid RViz + visited lebih dekat + speed sedikit naik"
    )

SawitNavigatorDFS.__init__ = _grid_v7_init

def _publish_grid_v7_marker(self):
    try:
        from visualization_msgs.msg import Marker, MarkerArray
        from geometry_msgs.msg import Point

        centers = _grid_v7_centers(self)
        xs = sorted(set(round(x, 2) for x, y in centers))
        ys = sorted(set(round(y, 2) for x, y in centers))
        current_idx = int(getattr(self, "search_wp_index", -1))

        arr = MarkerArray()

        # Hapus marker lama dulu.
        delete = Marker()
        delete.header.frame_id = "map"
        delete.ns = "bfs_grid_v7"
        delete.action = Marker.DELETEALL
        arr.markers.append(delete)

        # Garis 4x4 grid.
        line = Marker()
        line.header.frame_id = "map"
        line.ns = "bfs_grid_v7"
        line.id = 7000
        line.type = Marker.LINE_LIST
        line.action = Marker.ADD
        line.scale.x = 0.08
        line.color.r = 0.1
        line.color.g = 0.9
        line.color.b = 1.0
        line.color.a = 0.85

        # Horizontal.
        for y in ys:
            for a, b in zip(xs[:-1], xs[1:]):
                p1 = Point(); p1.x = float(a); p1.y = float(y); p1.z = 0.15
                p2 = Point(); p2.x = float(b); p2.y = float(y); p2.z = 0.15
                line.points.append(p1); line.points.append(p2)

        # Vertical.
        for x in xs:
            for a, b in zip(ys[:-1], ys[1:]):
                p1 = Point(); p1.x = float(x); p1.y = float(a); p1.z = 0.15
                p2 = Point(); p2.x = float(x); p2.y = float(b); p2.z = 0.15
                line.points.append(p1); line.points.append(p2)

        arr.markers.append(line)

        # Titik node 16 pohon/grid.
        for i, (x, y) in enumerate(centers):
            m = Marker()
            m.header.frame_id = "map"
            m.ns = "bfs_grid_v7"
            m.id = 7100 + i
            m.type = Marker.SPHERE
            m.action = Marker.ADD
            m.pose.position.x = float(x)
            m.pose.position.y = float(y)
            m.pose.position.z = 0.35
            m.pose.orientation.w = 1.0
            m.scale.x = 0.75
            m.scale.y = 0.75
            m.scale.z = 0.75

            if i == current_idx:
                m.color.r = 1.0
                m.color.g = 0.2
                m.color.b = 0.0
                m.color.a = 1.0
            else:
                m.color.r = 0.0
                m.color.g = 0.8
                m.color.b = 1.0
                m.color.a = 0.75

            arr.markers.append(m)

            t = Marker()
            t.header.frame_id = "map"
            t.ns = "bfs_grid_v7_text"
            t.id = 7200 + i
            t.type = Marker.TEXT_VIEW_FACING
            t.action = Marker.ADD
            t.pose.position.x = float(x)
            t.pose.position.y = float(y)
            t.pose.position.z = 1.3
            t.pose.orientation.w = 1.0
            t.scale.z = 0.9
            t.color.r = 1.0
            t.color.g = 1.0
            t.color.b = 1.0
            t.color.a = 1.0
            t.text = str(i)
            arr.markers.append(t)

        self.grid_marker_pub.publish(arr)

    except Exception as e:
        try:
            self.get_logger().warn(f"publish grid marker gagal: {e}")
        except Exception:
            pass

SawitNavigatorDFS._publish_grid_v7_marker = _publish_grid_v7_marker
# ===== GRID VISUAL STRICT V7 END =====



# ===== STRICT VISIT V8 START =====
_ORIG_INIT_STRICT_VISIT_V8 = SawitNavigatorDFS.__init__

def _strict_visit_v8_init(self, *args, **kwargs):
    _ORIG_INIT_STRICT_VISIT_V8(self, *args, **kwargs)

    # Biar marker hijau muncul hanya kalau drone beneran dekat.
    self.visit_distance = 3.0

    # Penting: karena kode asli ada threshold approach_standoff + 0.65.
    # Kalau standoff 3.0, visited bisa terasa jauh. Ini dibuat lebih ketat.
    self.approach_standoff = 4.6

    # ToF hanya bantu kalau benar-benar dekat, bukan 2.5 m.
    self.tof_visit_distance = 2.0
    self.tof_visit_max_distance = 2.60

    # Stop aman sebelum batang, tapi jangan langsung visited jauh.
    self.tof_stop_distance = 2.65
    self.cloud_stop_distance = 2.35
    self.cloud_stop_width = 0.85

    # Speed sedikit cepat tapi tetap aman.
    self.max_step = 0.20

    self.get_logger().warn(
        "STRICT VISIT V8 aktif: visited <=2.35m, ToF visit <=1.80m, grid-safe far visit OFF"
    )

SawitNavigatorDFS.__init__ = _strict_visit_v8_init

def _strict_no_grid_safe_visit_v8(self):
    # Matikan auto visited dari mode coverage/grid yang kadang menandai pohon dari jauh.
    # Visited tetap terjadi dari APPROACH saat dist benar-benar dekat.
    return

SawitNavigatorDFS.mark_nearby_confirmed_tracks = _strict_no_grid_safe_visit_v8
# ===== STRICT VISIT V8 END =====


def main(args=None):
    rclpy.init(args=args)
    node = SawitNavigatorDFS()
    executor = MultiThreadedExecutor(num_threads=3)
    executor.add_node(node)
    try:
        executor.spin()
    except KeyboardInterrupt:
        pass
    finally:
        executor.shutdown()
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
